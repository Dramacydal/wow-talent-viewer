{% extends 'base.html.twig' %}

{% block title %}WoW Vanilla Talents Viewer{% endblock %}

{% block body %}
    <main class="home">
        <h1 class="home-title">WoW Vanilla Talents Viewer</h1>

        <select id="home-build-select" class="home-build-select">
            {% for build in builds %}
                <option value="{{ build.label }}" {{ build.label == selectedBuild.label ? 'selected' : '' }}>{{ build.label }}</option>
            {% endfor %}
        </select>

        {% set classAbbreviations = {
            warrior: 'WAR', paladin: 'PAL', hunter: 'HUN', rogue: 'ROG', priest: 'PRI',
            shaman: 'SHA', mage: 'MAG', warlock: 'LCK', druid: 'DRU',
        } %}
        <div class="class-row">
            {% for class in availableClasses %}
                <a class="class-icon class-icon--{{ class.slug }}"
                   href="{{ path('talent_tree_page', { buildLabel: selectedBuild.label, classSlug: class.slug }) }}"
                   title="{{ class.name }}">
                    {% if class.iconPath %}
                        <img class="class-icon-img" src="/class-icons/{{ class.iconPath }}.png" alt="{{ class.name }}">
                    {% else %}
                        <span class="class-icon-label">{{ classAbbreviations[class.slug] ?? class.name|slice(0, 3)|upper }}</span>
                    {% endif %}
                </a>
            {% else %}
                <p class="class-row-empty">No classes have talent data on this build.</p>
            {% endfor %}
        </div>
    </main>
    <script>
        document.getElementById('home-build-select').addEventListener('change', (e) => {
            window.location.href = `/?build=${encodeURIComponent(e.target.value)}`;
        });
    </script>
{% endblock %}
