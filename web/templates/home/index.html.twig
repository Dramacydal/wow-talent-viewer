{% extends 'base.html.twig' %}

{% block title %}WoW Vanilla Talents Viewer{% endblock %}

{% block body %}
    <main class="home">
        <h1 class="home-title">WoW Vanilla Talents Viewer</h1>

        <div class="home-mode-toggle" role="group" aria-label="Mode">
            <button type="button" id="home-mode-view" aria-pressed="true">View</button>
            <button type="button" id="home-mode-compare" aria-pressed="false">Compare</button>
        </div>

        <div class="home-build-row">
            <select id="home-build-select" class="home-build-select">
                {% for build in builds %}
                    <option value="{{ build.label }}" {{ build.label == selectedBuild.label ? 'selected' : '' }}>{{ build.label }}</option>
                {% endfor %}
            </select>
            <span id="home-build-vs" class="home-build-row-vs" hidden>vs</span>
            <select id="home-build-select-b" class="home-build-select" hidden>
                {% for build in builds %}
                    <option value="{{ build.label }}" {{ loop.last ? 'selected' : '' }}>{{ build.label }}</option>
                {% endfor %}
            </select>
        </div>
        <p id="home-build-row-hint" class="home-build-row-hint" hidden>Pick two different builds to compare.</p>

        {% set classAbbreviations = {
            warrior: 'WAR', paladin: 'PAL', hunter: 'HUN', rogue: 'ROG', priest: 'PRI',
            shaman: 'SHA', mage: 'MAG', warlock: 'LCK', druid: 'DRU',
        } %}
        {% set initialSlugs = availableSlugsByBuildLabel[selectedBuild.label] ?? [] %}
        <div id="home-class-row" class="class-row">
            {% for class in allClasses %}
                <a class="class-icon class-icon--{{ class.slug }}"
                   data-slug="{{ class.slug }}"
                   href="{{ path('talent_tree_page', { buildLabel: selectedBuild.label, classSlug: class.slug }) }}"
                   title="{{ class.name }}"
                   {{ class.slug in initialSlugs ? '' : 'hidden' }}>
                    {% if class.iconPath %}
                        <img class="class-icon-img" src="{{ asset('class-icons/' ~ class.iconPath ~ '.png') }}" alt="{{ class.name }}">
                    {% else %}
                        <span class="class-icon-label">{{ classAbbreviations[class.slug] ?? class.name|slice(0, 3)|upper }}</span>
                    {% endif %}
                </a>
            {% endfor %}
            <p id="home-class-row-empty" class="class-row-empty" {{ initialSlugs is empty ? '' : 'hidden' }}>No classes have talent data on this build.</p>
        </div>
    </main>
    <script>
        (() => {
            const availableSlugsByBuildLabel = {{ availableSlugsByBuildLabel|json_encode|raw }};
            // Empty string at the domain root, "/talents" (no trailing slash) when mounted
            // under a sub-path via Apache Alias - see AssetUrlResolver/asset() for why a
            // hand-built absolute path like "/tree/..." can't just be a string literal.
            const basePath = {{ app.request.basePath|json_encode|raw }};
            const modeViewBtn = document.getElementById('home-mode-view');
            const modeCompareBtn = document.getElementById('home-mode-compare');
            const selectA = document.getElementById('home-build-select');
            const selectB = document.getElementById('home-build-select-b');
            const vsLabel = document.getElementById('home-build-vs');
            const icons = Array.from(document.querySelectorAll('#home-class-row .class-icon'));
            const emptyMessage = document.getElementById('home-class-row-empty');
            const sameBuildHint = document.getElementById('home-build-row-hint');

            let mode = 'view';

            function applyView(buildLabel) {
                const slugs = new Set(availableSlugsByBuildLabel[buildLabel] || []);
                let anyVisible = false;
                for (const icon of icons) {
                    const isAvailable = slugs.has(icon.dataset.slug);
                    icon.hidden = !isAvailable;
                    if (isAvailable) {
                        anyVisible = true;
                        icon.href = `${basePath}/tree/${encodeURIComponent(buildLabel)}/${icon.dataset.slug}`;
                    }
                }
                emptyMessage.hidden = anyVisible;
                sameBuildHint.hidden = true;
            }

            // A class can only be compared if it has talent data on BOTH builds - comparing
            // against a build where the class doesn't exist at all (e.g. Paladin before
            // 0.9.0.3807, Warlock before 0.11.0.3925 - see .claude-docs/gotchas.md on the
            // class rollout) has nothing to diff.
            function applyCompare(buildLabelA, buildLabelB) {
                if (buildLabelA === buildLabelB) {
                    for (const icon of icons) icon.hidden = true;
                    emptyMessage.hidden = true;
                    sameBuildHint.hidden = false;
                    return;
                }
                sameBuildHint.hidden = true;

                const slugsA = new Set(availableSlugsByBuildLabel[buildLabelA] || []);
                const slugsB = new Set(availableSlugsByBuildLabel[buildLabelB] || []);
                let anyVisible = false;
                for (const icon of icons) {
                    const isAvailable = slugsA.has(icon.dataset.slug) && slugsB.has(icon.dataset.slug);
                    icon.hidden = !isAvailable;
                    if (isAvailable) {
                        anyVisible = true;
                        icon.href = `${basePath}/compare/${encodeURIComponent(buildLabelA)}/${encodeURIComponent(buildLabelB)}/${icon.dataset.slug}`;
                    }
                }
                emptyMessage.hidden = anyVisible;
            }

            function refresh() {
                if (mode === 'view') {
                    applyView(selectA.value);
                } else {
                    applyCompare(selectA.value, selectB.value);
                }
            }

            modeViewBtn.addEventListener('click', () => {
                mode = 'view';
                modeViewBtn.setAttribute('aria-pressed', 'true');
                modeCompareBtn.setAttribute('aria-pressed', 'false');
                vsLabel.hidden = true;
                selectB.hidden = true;
                refresh();
            });

            modeCompareBtn.addEventListener('click', () => {
                mode = 'compare';
                modeCompareBtn.setAttribute('aria-pressed', 'true');
                modeViewBtn.setAttribute('aria-pressed', 'false');
                vsLabel.hidden = false;
                selectB.hidden = false;
                refresh();
            });

            selectA.addEventListener('change', () => {
                if (mode === 'view') {
                    const url = new URL(window.location.href);
                    url.searchParams.set('build', selectA.value);
                    history.replaceState(null, '', url);
                }
                refresh();
            });
            selectB.addEventListener('change', refresh);
        })();
    </script>
{% endblock %}
