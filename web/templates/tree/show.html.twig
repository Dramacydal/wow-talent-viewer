{% extends 'base.html.twig' %}

{% block title %}{{ class.name }} - {{ build.label }} - WoW Vanilla Talents Viewer{% endblock %}

{% block importmap %}{{ importmap('talent-tree') }}{% endblock %}

{% block body %}
    <div class="tt-picker">
        <a class="tt-picker-home" href="{{ path('home') }}">&larr; Builds</a>
        <form id="tt-picker-form">
            <select name="build">
                {% for b in allBuilds %}
                    <option value="{{ b.label }}" {{ b.label == build.label ? 'selected' : '' }}>{{ b.label }}</option>
                {% endfor %}
            </select>
        </form>
        {% set availableSlugs = availableSlugsByBuildLabel[build.label] ?? [] %}
        <div class="tt-class-picker">
            {% for c in allClasses %}
                {% if c.slug in availableSlugs %}
                    <a class="tt-class-icon {{ c.slug == class.slug ? 'tt-class-icon--active' : '' }}"
                       href="{{ path('talent_tree_page', { buildLabel: build.label, classSlug: c.slug }) }}"
                       title="{{ c.name }}">
                        {% if c.iconPath %}
                            <img class="tt-class-icon-img" src="{{ asset('class-icons/' ~ c.iconPath ~ '.png') }}" alt="{{ c.name }}">
                        {% endif %}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
        <button id="tt-settings-gear" class="tt-settings-gear" type="button" title="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </button>
    </div>
    <div id="talent-tree-app" data-tree-url="{{ path('api_talent_tree', { buildLabel: build.label, classSlug: class.slug }) }}"></div>
    <div id="tt-settings-overlay" class="tt-settings-overlay" hidden>
        <div class="tt-settings-modal">
            <h2>Settings</h2>
            <label class="tt-settings-row">
                <input id="tt-setting-sort-alpha" type="checkbox">
                Sort tabs alphabetically
            </label>
            <label class="tt-settings-row">
                <input id="tt-setting-show-id" type="checkbox">
                Show talent ID in tooltip
            </label>
            <button id="tt-settings-close" class="tt-settings-close" type="button">Close</button>
        </div>
    </div>
    <script>
        const ttForm = document.getElementById('tt-picker-form');
        const ttBasePath = {{ app.request.basePath|json_encode|raw }};
        // Switching build re-renders server-side (class-icon availability can differ per
        // build - see tt-class-picker above), so this just navigates to the same class slug
        // on the newly-picked build; if that class isn't available there, the backend 404s
        // the same way a stale/bookmarked URL would - no special-casing needed here.
        ttForm.build.addEventListener('change', () => {
            window.location.href = `${ttBasePath}/tree/${encodeURIComponent(ttForm.build.value)}/{{ class.slug }}`;
        });

        const ttSettingsGear = document.getElementById('tt-settings-gear');
        const ttSettingsOverlay = document.getElementById('tt-settings-overlay');
        const ttSettingsClose = document.getElementById('tt-settings-close');
        const ttSettingSortAlpha = document.getElementById('tt-setting-sort-alpha');
        const ttSettingShowId = document.getElementById('tt-setting-show-id');

        ttSettingsGear.addEventListener('click', () => {
            // window.ttApp is the mounted Vue instance (assigned at the bottom of
            // talent-tree.js) - read its live `settings` to populate the checkboxes,
            // rather than re-reading localStorage ourselves (single source of truth).
            const settings = window.ttApp.settings;
            ttSettingSortAlpha.checked = settings.sortTabsAlphabetically;
            ttSettingShowId.checked = settings.showTalentIdInTooltip;
            ttSettingsOverlay.hidden = false;
        });

        ttSettingsClose.addEventListener('click', () => { ttSettingsOverlay.hidden = true; });
        ttSettingsOverlay.addEventListener('click', (e) => {
            if (e.target === ttSettingsOverlay) ttSettingsOverlay.hidden = true;
        });

        // Mutating window.ttApp.settings directly triggers Vue's own reactivity (it's the
        // same reactive object the app renders from) and its $watch persists to
        // localStorage - no event bus needed between this plain script and the Vue app.
        ttSettingSortAlpha.addEventListener('change', (e) => {
            window.ttApp.settings.sortTabsAlphabetically = e.target.checked;
        });
        ttSettingShowId.addEventListener('change', (e) => {
            window.ttApp.settings.showTalentIdInTooltip = e.target.checked;
        });
    </script>
{% endblock %}
